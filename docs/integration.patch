     global _SINGLETON
     if _SINGLETON is None:
         mode = os.environ.get("SENTINEL_BACKEND", "local")
-        _SINGLETON = AwsBackendOps() if mode == "aws" else LocalBackendOps()
+        # Integration by Tishneet: retain Ishani's reference modes while adding
+        # the durable workflow adapter used by Compose and the AWS migration.
+        if mode == "workflow":
