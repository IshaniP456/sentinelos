# Copy to .env.local for local development.
#
# Leave VITE_MOCK=true to run the fully interactive dashboard against the
# in-browser mock engine (no backend required). Flip to false once the real
# API Gateway base URL is available.
VITE_MOCK=true

# Base path for the deployed API Gateway (see integration contract §5).
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/v1
VITE_API_BASE_URL=/v1
