{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SentinelOS PlanActions (Author: Tishneet)",
  "type": "object",
  "additionalProperties": false,
  "required": ["actions"],
  "properties": {
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "from", "to", "count"],
        "properties": {
          "type": {"const": "move_packages"},
          "from": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "to": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
          "count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
